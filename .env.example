# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Full connection string, e.g.:
#   postgres://user:password@localhost:5432/labcei
DATABASE_URL=postgres://labcei_user:changeme@localhost:5432/labcei

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Express API server ───────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed CORS origins (in addition to localhost defaults)
# Example for production: https://labcei.example.com
ALLOWED_ORIGINS=

# ─── Expo / React Native frontend ────────────────────────────────────────────
# URL of the API server — must be reachable from the device/browser running the app
# Development (same machine):
EXPO_PUBLIC_API_URL=http://localhost:3001
# Production (org server):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
