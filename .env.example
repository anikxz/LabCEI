# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Full connection string, e.g.:
#   postgres://user:password@localhost:5432/labcei
DATABASE_URL=postgres://labcei_user:changeme@localhost:5432/labcei

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── HRMS directory auth (optional) ──────────────────────────────────────────
# When set, users can log in with their HRMS username + password in addition to
# locally-created accounts. Leave HRMS_AUTH_URL blank to disable HRMS login.
HRMS_AUTH_URL=http://192.168.200.200:8281/auth/CheckUser/index
HRMS_SYS_NAME=global_report

# ─── Express API server ───────────────────────────────────────────────────────
PORT=3001

# ─── Notification digest scheduler ────────────────────────────────────────────
# Automated server-side digest. Set NOTIFY_SCHEDULER=off to disable.
# NOTIFY_INTERVAL_MS controls how often the scheduler ticks (default 3600000 = 1h).
# Per-user cadence gating prevents duplicate sends regardless of tick frequency.
NOTIFY_SCHEDULER=on
NOTIFY_INTERVAL_MS=3600000

# ─── OCR (document text extraction) ──────────────────────────────────────────
# Uses the `tesseract.js` package (install with: cd api && npm install).
# Set OCR_ENABLED=off to skip OCR (uploads still work, just without text extraction).
# OCR_LANG selects the traineddata language(s), e.g. "eng" or "eng+ara".
# By default tesseract.js downloads the traineddata from a CDN on first run; on an
# offline/LAN server, point OCR_LANG_PATH to a local folder holding <lang>.traineddata.gz.
OCR_ENABLED=on
OCR_LANG=eng
# OCR_LANG_PATH=/opt/labcei/tessdata

# Comma-separated list of allowed CORS origins (in addition to localhost defaults)
# Example for production: https://labcei.example.com
ALLOWED_ORIGINS=

# ─── Expo / React Native frontend ────────────────────────────────────────────
# URL of the API server — must be reachable from the device/browser running the app
# Development (same machine):
EXPO_PUBLIC_API_URL=http://localhost:3001
# Production (org server):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
